generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           String    @default("STUDENT")
  collegeId      String?
  collegeName    String?
  studentId      String?   @unique
  empNumber      String?   @unique
  departmentId   String?
  departmentName String?
  incomingYear   Int?
  outgoingYear   Int?
  avatar         String?
  preferences    String?   @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedules      Schedule[]
  notifications  Notification[]
  assignments    Assignment[]
  grades         Grade[]
  attendance     Attendance[]
  chatSessions   ChatSession[]
  integrations   UserIntegration[]
  tasks          Task[]
  college        College?    @relation(fields: [collegeId], references: [id])
  department     Department? @relation(fields: [departmentId], references: [id])
  hackathonsCreated Hackathon[] @relation("HackathonCreator")
  registrations     HackathonRegistration[]
  formsCreated      Form[]
  formResponses     FormResponse[]
  teachingCourses   Course[]
  enrollments       Enrollment[]
  createdRooms      Room[]
  joinedRooms       RoomMember[]
  uploadedResources Resource[]
  roomNotifications RoomNotification[]
  internships         Internship[]
  internshipRegistrations InternshipRegistration[]
  codingContests      CodingContest[]
  codingProfile         CodingProfile?
  contestParticipations ContestParticipation[]
}

model CodingProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  leetcodeHandle   String?
  codeforcesHandle String?
  codechefHandle   String?
  hackerrankHandle String?
  gfgHandle        String?
  lastSyncedAt     DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContestParticipation {
  id             String    @id @default(uuid())
  userId         String
  contestId      String?
  platform       String
  contestName    String
  contestUrl     String?
  rank           Int?
  score          Int?
  rating         Int?
  ratingChange   Int?
  problemsSolved Int?
  totalProblems  Int?
  participatedAt DateTime?
  syncedAt       DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, contestName])
}

model Schedule {
  id          String   @id @default(cuid())
  userId      String
  title       String
  course      String?
  location    String?
  teacher     String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  type        String   @default("CLASS")
  color       String?
  recurring   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  priority  String   @default("MEDIUM")
  read      Boolean  @default(false)
  source    String?
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String   @id @default(uuid())
  userId      String
  courseId     String
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  progress    Int      @default(0)
  grade       String?
  maxGrade    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Grade {
  id         String   @id @default(uuid())
  userId     String
  courseId    String?
  courseName String
  semester   Int
  credits    Int
  grade      String
  gpa        Float
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])
}

model Attendance {
  id         String   @id @default(uuid())
  userId     String
  courseId    String?
  courseName String
  date       DateTime
  status     String
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])
}

model Course {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  credits   Int      @default(3)
  teacherId String
  collegeId String?
  semester  String?
  teacher   User     @relation(fields: [teacherId], references: [id])
  college   College? @relation(fields: [collegeId], references: [id])
  enrollments Enrollment[]
  grades     Grade[]
  attendances Attendance[]
  createdAt  DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId   String
  student   User     @relation(fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  duration    Int?
  category    String   @default("personal")
  priority    String   @default("MEDIUM")
  status      String   @default("PENDING")
  completed   Boolean  @default(false)
  color       String?
  isClass     Boolean  @default(false)
  courseId     String?
  location    String?
  recurrence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserIntegration {
  id           String    @id @default(uuid())
  userId       String
  type         String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model College {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  address     String?
  phone       String?
  website     String?
  logo        String?
  adminEmail  String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  hackathons  Hackathon[]
  forms       Form[]
  courses     Course[]
  departments Department[]
  internships         Internship[]
  codingContests      CodingContest[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  collegeId String
  createdAt DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users   User[]

  @@unique([collegeId, name])
}

model Hackathon {
  id              String   @id @default(uuid())
  creatorId       String
  collegeId       String?
  title           String
  description     String?
  url             String?
  organizer       String?
  registrationUrl String?
  startDate       DateTime?
  endDate         DateTime?
  deadline        DateTime?
  teamSize        Int?
  themes          String?   @default("[]")
  location        String?
  mode            String?   @default("OFFLINE")
  eligibility     String?   @default("{}")
  prizePool       String?
  duration        String?
  schedule        String?
  bootcamps       String?   @default("[]")
  highlights      String?   @default("[]")
  targetDepartments  String?  @default("[]")
  targetYears        String?  @default("[]")
  eligibilityEnabled Boolean  @default(false)
  status          String   @default("DRAFT")
  source          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator       User                   @relation("HackathonCreator", fields: [creatorId], references: [id])
  college       College?               @relation(fields: [collegeId], references: [id])
  registrations HackathonRegistration[]
  rounds        HackathonRound[]
}

model HackathonRegistration {
  id           String   @id @default(uuid())
  hackathonId  String
  userId       String
  teamName     String?
  teamMembers  String?
  projectIdea  String?
  status       String   @default("REGISTERED")
  currentRound Int      @default(0)
  winPosition  String?  // 1st, 2nd, 3rd, or "Completed" if no position
  review       String?  // Student's review after final round
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
}

model HackathonRound {
  id           String   @id @default(uuid())
  hackathonId  String
  roundNumber  Int
  title        String
  description  String?
  date         DateTime?
  resultDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, roundNumber])
}

model Opportunity {
  id              String   @id @default(uuid())
  type            String   // HACKATHON | INTERNSHIP
  title           String
  description     String?
  url             String
  source          String   // devfolio | devpost | internshala | hackerrank | manual
  organizer       String?
  deadline        String?
  startDate       String?
  duration        String?
  location        String?
  mode            String?  // ONLINE | OFFLINE | HYBRID
  prizePool       String?
  stipend         String?
  company         String?
  role            String?
  status          String   @default("PENDING")  // PENDING | APPROVED | REJECTED
  approvedBy      String?
  assignedTo      String?
  collegeId       String?
  isAutoFetched   Boolean  @default(false)
  fetchedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([collegeId])
}

model Internship {
  id                 String   @id @default(uuid())
  creatorId          String
  collegeId          String
  title              String
  description        String
  company            String
  role               String
  url                String
  stipend            String?
  duration           String?
  mode               String   @default("REMOTE")
  startDate          String?
  deadline           String?
  targetDepartments  String   @default("[]")
  targetYears        String   @default("[]")
  eligibilityEnabled Boolean  @default(false)
  status             String   @default("ACTIVE")
  source             String?
  createdAt          DateTime @default(now())
  creator            User     @relation(fields: [creatorId], references: [id])
  college            College  @relation(fields: [collegeId], references: [id])
  registrations      InternshipRegistration[]
}

model InternshipRegistration {
  id           String     @id @default(uuid())
  internshipId String
  userId       String
  status       String     @default("REGISTERED")
  reportedAt   DateTime?
  internship   Internship @relation(fields: [internshipId], references: [id])
  user         User       @relation(fields: [userId], references: [id])
  @@unique([internshipId, userId])
}

model CodingContest {
  id            String   @id @default(uuid())
  title         String
  platform      String
  url           String
  startTime     String
  duration      Int?
  contestType   String?
  status        String   @default("UPCOMING")
  solutions     String   @default("[]")
  isAutoFetched Boolean  @default(false)
  creatorId     String?
  collegeId     String?
  createdAt     DateTime @default(now())
  creator       User?    @relation(fields: [creatorId], references: [id])
  college       College? @relation(fields: [collegeId], references: [id])
}

model Form {
  id                  String    @id @default(uuid())
  creatorId           String
  collegeId           String?
  title               String
  description         String?
  status              String    @default("ACTIVE")
  allowEdit           Boolean   @default(false)
  expiresAt           DateTime?
  targetDepartments   String    @default("[]")
  targetYears         String    @default("[]")
  eligibilityEnabled  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  creator    User           @relation(fields: [creatorId], references: [id])
  college    College?       @relation(fields: [collegeId], references: [id])
  fields     FormField[]
  responses  FormResponse[]
  formRooms  FormRoom[]
}

model FormRoom {
  id        String   @id @default(uuid())
  formId    String
  roomId    String
  createdAt DateTime @default(now())
  
  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  
  @@unique([formId, roomId])
  @@index([formId])
  @@index([roomId])
}

model FormField {
  id          String   @id @default(uuid())
  formId      String
  label       String
  type        String   @default("TEXT")
  required    Boolean  @default(false)
  options     String?   @default("[]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormResponse {
  id         String   @id @default(uuid())
  formId     String
  userId     String
  answers    String   @default("{}")
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model Room {
  id            String   @id @default(uuid())
  name          String
  description   String   @default("")
  joinCode      String   @unique
  teacherId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher     User          @relation(fields: [teacherId], references: [id])
  members     RoomMember[]
  resources   Resource[]
  notifications RoomNotification[]
  formRooms   FormRoom[]

  @@index([teacherId])
  @@index([joinCode])
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  studentId String
  isCR      Boolean  @default(false)
  joinedAt  DateTime @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, studentId])
  @@index([roomId])
  @@index([studentId])
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  fileUrl     String
  fileType    String   @default("other") // pdf, ppt, link, other
  category    String   @default("other") // lecture, assignment, reference, other
  roomId      String
  uploadedBy  String
  createdAt   DateTime @default(now())

  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([roomId])
  @@index([uploadedBy])
}

model RoomNotification {
  id         String   @id @default(uuid())
  roomId     String
  studentId  String
  message    String
  resourceUrl String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([studentId])
  @@index([isRead])
}