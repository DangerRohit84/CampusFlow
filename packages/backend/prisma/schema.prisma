generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled: -pooler host + pgbouncer=true&connection_limit=50&pool_timeout=30&channel_binding=prefer&connect_timeout=30 (keeps Render+Neon warm via /api/health; 50 for 10k burst headroom)
  directUrl = env("DIRECT_URL") // Neon direct (no pooler, no pgbouncer) for migrations, channel_binding=prefer&connect_timeout=30
}

// Order 4 (V-04 slice 1 + V-30): closed hot domains as native PG enums (P7).
// Shared where values match (Priority, RegistrationStatus, StagingStatus,
// StagingDecision, Platform), per-domain where not (HackathonStatus vs
// InternshipStatus vs ContestStatus vs CollegeStatus vs FormStatus vs
// ReportStatus vs TaskStatus vs AssignmentStatus vs SubmissionStatus vs
// SourceHealthStatus). Deferred to Order 12 (stay String): Hackathon/
// Internship.mode, Notification.type, Task.category, FormField.type,
// Room.chatMode, Resource.fileType/category, PlatformSettings.platform/type,
// AuditLog.action/entityType/actorRole, AiUsage.feature, AiRouting.feature,
// AiProvider.type, UserIntegration.type, Schedule.type, ChatMessage.role,
// ContestParticipation.contestType-ish open fields, Grade.grade, etc.
// Migration 20260921000000_order4_enums: census → normalize (legacy role
// variants ADMIN→COLLEGE_ADMIN, STAFF→TEACHER, SUPER→SUPER_ADMIN; unknowns
// → safe default + RAISE NOTICE log) → CREATE TYPE → ALTER … USING
// UPPER(TRIM(col))::"Type" → (collegeId, decision) indexes. Prisma enums are
// strings at runtime so `user.role === 'STUDENT'` comparisons keep working;
// validators.ts zod enums are the app SSOT and must match these values.
enum UserRole {
  STUDENT
  TEACHER
  COLLEGE_ADMIN
  SUPER_ADMIN
}

enum StagingDecision {
  APPROVED
  REJECTED
}

enum StagingStatus {
  DRAFT
  PENDING
  ACTIVE
  APPROVED
  REJECTED
}

enum HackathonStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum InternshipStatus {
  ACTIVE
  ENDED
}

enum ContestStatus {
  UPCOMING
  ONGOING
  ENDED
}

enum CollegeStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum FormStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ReportScope {
  COLLEGE
  WEBSITE
}

enum ReportIssueType {
  DESIGN
  BUG
  CRASH
  PERFORMANCE
  SECURITY
  FEATURE_REQUEST
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

enum RegistrationStatus {
  REGISTERED
  SELECTED
  REJECTED
  COMPLETED
  ACCEPTED
}

enum SourceHealthStatus {
  OK
  DEGRADED
  DOWN
  UNKNOWN
}

enum Platform {
  CODEFORCES
  CODECHEF
  LEETCODE
  ATCODER
  HACKERRANK
  GFG
  OTHER
}

// Order 12 (V-04-rest slice 2 → P7): closed remainder domains as native PG
// enums. Only truly closed sets with an app SSOT convert; open/source-driven
// text stays String (Hackathon/Internship.mode per-source ONLINE/OFFLINE/
// HYBRID/REMOTE/ONSITE divergence in details.ts, Notification.type open,
// Task.category open, FormField.type open, Room.chatMode locked by
// db-fix-04-enums slice-boundary test, Resource.fileType/category derived via
// getFileType() incl. 'doc'/'xls'/'image', PlatformSettings.*, AuditLog.*,
// AiUsage/AiRouting.feature, AiProvider.type, UserIntegration.type,
// Grade.grade open letter/score text). Prisma enums are strings at runtime so
// `x === 'CLASS'` comparisons keep working; validators.ts zod enums are SSOT.
// Migration 20260925000000_order12_rolesplit: census → normalize unknowns to
// safe default + RAISE NOTICE → CREATE TYPE → ALTER … USING
// UPPER(TRIM(col::text))::"Type".
// Repair 20260926020000_repair_schedule_type_expand: expands to 4 values
// (CLASS/LAB + SEMINAR/OTHER from seed demo timetable: Placement Prep SEMINAR,
// Club Meeting OTHER). Additive ALTER TYPE ... ADD VALUE IF NOT EXISTS (no
// rewrite, existing rows untouched). Validators + route coercions mirror.
enum ScheduleType {
  CLASS
  LAB
  SEMINAR
  OTHER
}

enum ChatMessageRole {
  USER
  ASSISTANT
}

enum GradeSource {
  MANUAL
  CALCULATOR
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  username       String?  @unique
  passwordHash   String
  role           UserRole @default(STUDENT)
  collegeId      String?
  // Order 6 (V-01): collegeName display copy DROPPED — resolve via college relation
  // (include college { select name }) or VIEW. Drift census in migration
  // 20260922000000_order5_9 before DROP. API keeps `collegeName` key as
  // projection (see routes/auth|reports|publicProfile) for compat.
  // Order 12 (V-03-full → P3 CTI expand phase): role-conditional columns below
  // (studentId/incomingYear/outgoingYear → StudentProfile, empNumber →
  // StaffProfile) are TRANSITION TWINS — KEPT during dual-write. Writers fill
  // BOTH User cols + profile rows (best-effort, pre-migration safe);
  // readers use resolveStudentFields()/resolveStaffFields() (profile-first,
  // User fallback) with IDENTICAL API shapes. Contract (SET NOT NULL on
  // profiles + DROP old cols) is a LATER order once reconciliation is green —
  // do NOT drop here. chk_user_role_fields still guards User cols.
  studentId      String?  @unique
  empNumber      String?  @unique
  departmentId   String?
  // Order 6 (V-02): departmentName display copy DROPPED — resolve via
  // department relation. Same projection-compat pattern as collegeName.
  // Order 12 CTI: incoming/outgoingYear canonical home is StudentProfile
  // (twin kept here during transition — see studentId comment above).
  incomingYear   Int?
  outgoingYear   Int?
  avatar         String?
  portfolioUrl   String?
  // Order 9 (V-05): String "{}" → Json (JSONB). GIN + CHECK(jsonb_typeof='object').
  // Readers handle Json|String via parsePreferencesSafe (validators.ts +
  // room/mute.ts); writers pass objects (no JSON.stringify). Migration
  // 20260922000000_order5_9 backfills invalid → '{}' then ALTER USING ::jsonb.
  preferences    Json?    @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  reports        Report[]

  schedules     Schedule[]
  notifications Notification[]
  assignments   Assignment[]
  grades        Grade[]

  chatSessions            ChatSession[]
  integrations            UserIntegration[]
  tasks                   Task[]
  college                 College?                 @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  department              Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  hackathonsCreated       Hackathon[]              @relation("HackathonCreator")
  registrations           HackathonRegistration[]
  hackathonTeamMemberships HackathonTeamMember[]
  formsCreated            Form[]
  formResponses           FormResponse[]
  teachingCourses         Course[]
  enrollments             Enrollment[]
  createdRooms            Room[]
  joinedRooms             RoomMember[]
  uploadedResources       Resource[]
  roomNotifications       RoomNotification[]
  roomMessages            RoomMessage[]              @relation("RoomMessageSender")
  pinnedMessages          RoomMessage[]              @relation("RoomMessagePinnedBy")
  roomChatPermissions     RoomChatAllowedMember[]
  messageHides            MessageHide[]
  messageReactions        MessageReaction[]
  formViews               FormView[]
  auditLogs               AuditLog[]
  revokedTokens           RevokedToken[]
  syncThrottle            SyncThrottle?
  hackathonDecisions      HackathonStagingDecision[] @relation("HackathonDecisionBy")
  internshipDecisions     InternshipStagingDecision[] @relation("InternshipDecisionBy")
  internships             Internship[]
  internshipRegistrations InternshipRegistration[]
  codingContests          CodingContest[]
  contestReminders        ContestReminder[]
  codingProfile           CodingProfile?
  contestParticipations   ContestParticipation[]
  codingActivities        CodingActivity[]
  hackathonStagings       HackathonStaging[]       @relation("HackathonStagingCreator")
  internshipStagings      InternshipStaging[]      @relation("InternshipStagingCreator")
   attendanceData          AttendanceData?
  attendanceRecords       AttendanceRecord[]
  gradeData               GradeData?
   announcementsCreated    Announcement[]
  announcementReads     AnnouncementRead[]
  roomReads           RoomRead[]
  createdAssignmentHubs AssignmentHub[]      @relation("AssignmentHubCreator")
  assignmentSubmissions AssignmentSubmission[]
  gradedSubmissions     AssignmentSubmission[] @relation("SubmissionGrader")
  offlineVerifiedSubmissions AssignmentSubmission[] @relation("SubmissionOfflineVerifier")
  // Order 12 (V-03-full → P3 CTI): 1–1 delegated-type profiles. STUDENT →
  // StudentProfile, TEACHER/COLLEGE_ADMIN/SUPER_ADMIN → StaffProfile (admins
  // reuse StaffProfile: no admin-only columns exist today, a third empty
  // AdminProfile would add join cost for zero facts; add it via the same
  // expand pattern if admin-only fields ever appear). userId is PK+FK Cascade
  // (profile dies with User, never orphans). New tables use uuid() (P10 tail:
  // pick-one for new tables; existing cuid() PKs stay — no PK rewrite).
  studentProfile StudentProfile?
  staffProfile   StaffProfile?

  @@index([collegeId, role])
  // Order 12 tail (P8): redundant @@index([collegeId]) DROPPED — leftmost-covered
  // by @@index([collegeId, role]). Planner keeps the composite.
  @@index([role])
  @@index([departmentId])
  @@index([collegeId, departmentId])
  @@index([username])
  @@index([collegeId, createdAt])
  @@index([createdAt])
  @@index([preferences], type: Gin, map: "User_preferences_gin")
}

// Order 5 (V-03-CHECKs): User role↔field invariant enforced by DB CHECK
// chk_user_role_fields (see migration 20260922000000_order5_9):
// (role='STUDENT' AND "empNumber" IS NULL) OR (role<>'STUDENT' AND "studentId" IS NULL).
// STUDENT must never carry empNumber; non-STUDENT must never carry studentId.
// incomingYear/outgoingYear documented for CTI split (Order 12) — not in CHECK
// yet (existing rows vary). Prisma guard mirrors DB (validators.ts
// validateUserRoleFields, enforced in routes/auth.ts register).

// Order 12 (V-03-full → P3 CTI delegated types, expand phase): class-table
// inheritance for role-conditional User columns. Shared auth/tenant core stays
// in User (id/email/name/username/passwordHash/role/collegeId/departmentId/
// avatar/portfolioUrl/preferences/timestamps); role-conditional facts move here:
// - StudentProfile: STUDENT-only (studentId UNIQUE, incomingYear, outgoingYear).
// - StaffProfile: TEACHER/COLLEGE_ADMIN/SUPER_ADMIN (empNumber UNIQUE).
// 1–1 via userId PK→FK Cascade (same boundary as CodingProfile/GradeData/
// AttendanceData). Twins in User KEPT during transition (dual-write +
// profile-first resolvers, same shapes); contract drops later. Backfill in
// migration 20260925000000_order12_rolesplit (per-role INSERT … WHERE NOT
// EXISTS + ON CONFLICT DO NOTHING; reconciliation census §5). Timestamps on
// both (mutable 1–1, V-31 hygiene). No AdminProfile: admins share StaffProfile
// shape today (see User relation comment).
model StudentProfile {
  userId       String   @id
  studentId    String?  @unique
  incomingYear Int?
  outgoingYear Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([incomingYear])
  @@map("StudentProfile")
}

model StaffProfile {
  userId    String   @id
  empNumber String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([empNumber])
  @@map("StaffProfile")
}

model CodingProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  leetcodeHandle   String?
  codeforcesHandle String?
  codechefHandle   String?
  hackerrankHandle String?
  gfgHandle        String?
  githubUsername   String?
  // Order 9 (V-06): String? → Json? (JSONB array of per-platform stats).
  // Minimal Json (read-whole/write-whole); proper child table is Order 10+.
  // GIN for future containment; readers handle Json|String via
  // parsePlatformStatsSafe. Migration backfills invalid → '[]'.
  platformStats    Json?
  lastSyncedAt     DateTime?
  // Upgrade 3: per-user sync failure surface (set on fail, cleared on success).
  // UI shows "updated Xh ago / retry" from lastSyncedAt + this field instead of
  // silently advancing lastSyncedAt on total failure (masking fix).
  lastSyncError    String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ranked cause #4 (missing composite indexes): per-handle lookups for syncAllUsers
  // OR-query (leetcode/codeforces/codechef/hackerrank/gfg NOT NULL). Single-column
  // B-tree indexes are the best-supported shape — a composite (a,b,c) cannot serve
  // OR branches, while 3 singles let Postgres BitmapOr across branches.
  @@index([leetcodeHandle])
  @@index([codeforcesHandle])
  @@index([codechefHandle])
  @@index([platformStats], type: Gin, map: "CodingProfile_platformStats_gin")
}

// Upgrade 3b: DB-backed per-user manual-sync throttle (60s button guard).
// Multi-instance safe + survives restarts. Until migration
// 20260910000000_sync_upgrades is applied, code falls back to process-local
// memory (documented limit — see syncThrottleStore.ts).
model SyncThrottle {
  userId          String   @id
  lastRequestedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("SyncThrottle")
}

model ContestParticipation {
  id             String    @id @default(uuid())
  userId         String
  contestId      String?
  platform       Platform
  contestName    String
  contestUrl     String?
  rank           Int?
  score          Int?
  rating         Int?
  ratingChange   Int?
  problemsSolved Int?
  totalProblems  Int?
  participatedAt DateTime?
  syncedAt       DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contest        CodingContest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@unique([userId, platform, contestName])
  // Ranked cause #4: per-user history (userId+platform ORDER BY participatedAt),
  // per-contest roster (contestId), leaderboard/groupBy + fallback scan (platform,
  // platform+userId). Existing @@unique kept (upsert path).
  // Order 7 (V-29) snapshot contract: contestName/contestUrl/rating/rank/score/
  // problemsSolved are SNAPSHOT_AT_SYNC (asOf syncedAt), canonical is CodingContest
  // when contestId set. Drift census in migration 20260922000000_order5_9
  // (participation vs CodingContest where contestId set). Readers prefer canonical
  // via resolveContestDisplay() (validators.ts): contestId ? contest.title/url
  // : snapshot contestName/contestUrl. syncEngine refreshes snapshot on every
  // sync (contestId re-resolved + syncedAt advanced). No column dropped
  // (additive-safe); natural key @@unique kept.
  @@index([userId, platform, participatedAt])
  @@index([contestId])
  @@index([platform])
  @@index([platform, userId])
  @@index([contestId, syncedAt])
}

// Unified heatmap daily activity (additive, 20260911_coding_activity).
// Per-day SOLVES where honestly obtainable: LeetCode submissionCalendar +
// Codeforces accepted-per-day + GitHub contributions snapshot. CodeChef /
// HackerRank / GFG have NO daily API — omitted by design (totals stay in
// platformStats cards, never faked into this table). `date` is UTC midnight;
// `source` is 'leetcode' | 'codeforces' | 'github' (validated in app, kept
// String for additive safety — no enum rewrite). @@unique[userId,date,source]
// is the idempotency key for sync createMany(skipDuplicates). Deploy: additive
// CREATE TABLE IF NOT EXISTS (see migration); runtime is pre-migration safe
// (codingActivity.ts degrades to warn-once skip when the table/client is old).
model CodingActivity {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime
  source    String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, source])
  @@index([userId, date])
  @@map("CodingActivity")
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  course    String?
  location  String?
  teacher   String?
  dayOfWeek Int
  startTime String
  endTime   String
  // Order 8 (V-22): typed minutes-since-midnight alongside legacy String times.
  // Recurring weekly template has no absolute date → Int minutes (0-1439) is the
  // correct temporal type (not TIMESTAMPTZ). Dual-write: validators
  // timeToMinutes() + CHECK 0-1439 in migration. Ordering migrates to
  // startMinutes; String cols kept until contract (Order 12).
  startMinutes Int?
  endMinutes   Int?
  // Order 12 (V-04-rest): closed domain → native enum. Repair 20260926020000
  // expands to 4 real values (seed + app audit): CLASS (default, lectures +
  // AI-unknown fallback), LAB (lab heuristic), SEMINAR (Placement Prep),
  // OTHER (Club Meeting). Routes preserve all four (schedules.ts + timetable
  // save coerce only true ghosts → CLASS). Prisma enum is a string at runtime;
  // zod ScheduleTypeEnum mirrors (validators.ts).
  type      ScheduleType @default(CLASS)
  color     String?
  // Order 12 (V-23 keep-lite): no RecurrenceRule table — no "occurrences next
  // week" query exists (recurrence is write-only, Task.recurrence free text
  // unqueried). Weekly template recurrence = recurring=true + dayOfWeek 0–6
  // (zod 0–6 guard in schedules.ts). Documented RRULE-lite grammar for future:
  // Task.recurrence SHOULD be NULL or match ^(DAILY|WEEKLY|MONTHLY)(;INTERVAL=\d+)?(;COUNT=\d+)?$
  // (≤200 chars); enforce in app via isValidRecurrence() (validators.ts) when
  // recurrence queries materialize, then add DB CHECK + child table. No DDL here.
  recurring Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dayOfWeek])
  @@index([userId, dayOfWeek, startMinutes])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  priority  Priority @default(MEDIUM)
  read      Boolean  @default(false)
  source    String?
  // Order 9 (V-19): String? → Json? (JSONB object). No containment query yet;
  // GIN for future @>/?; readers handle Json|String via parseMetadataSafe.
  metadata  Json?
  createdAt DateTime @default(now())
  // Order 12 tail (P10): missing updatedAt added (mutable: read flag flips).
  // Existing rows backfill to statement time via DEFAULT in migration.
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([userId, read, createdAt])
  @@index([metadata], type: Gin, map: "Notification_metadata_gin")
}

// @deprecated — legacy per-user assignments; use AssignmentHub for scoped assignments
model Assignment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String?
  title       String
  description String?
  dueDate     DateTime
  status      AssignmentStatus @default(PENDING)
  priority    Priority         @default(MEDIUM)
  progress    Int      @default(0)
  grade       String?
  maxGrade    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([courseId])
}

model Grade {
  id         String   @id @default(uuid())
  userId     String
  courseId   String?
  // Order 6 (V-21): courseName display copy DROPPED — resolve via course
  // relation (include course { select name }). No snapshot: Grade has no
  // updatedAt so snapshot semantics unprovable; transcript rename history is
  // out of scope (revisit with gradedAt snapshot if required). API keeps
  // `courseName` key as projection for compat (see chat.ts/ai.ts).
  // Order 11 (V-15 → P6/P9): Grade is the RECORD (not cache). Calculator
  // scratchpad (GradeData.subjects blob) migrates here as rows with
  // source=CALCULATOR + free-form subject/subjectCode when courseId IS NULL
  // (no Course row). Institutional/transcript rows keep courseId set and
  // source=MANUAL (never touched by calculator replace-all sync in
  // routes/grades.ts). semester=0 buckets calculator rows (real semesters
  // are 1..N). updatedAt added for V-31 timestamp hygiene (mutable entity).
  subject     String?
  subjectCode String?
  // Order 12 (V-04-rest): closed 2-value domain → native enum. MANUAL =
  // institutional/transcript (never touched by calculator replace-all);
  // CALCULATOR = GradeData scratchpad mirror (semester=0 bucket). Writers pass
  // string literals (Prisma enum is a string at runtime); zod GradeSourceEnum
  // mirrors (validators.ts). grade stays String (open letter/score text, P7).
  source      GradeSource @default(MANUAL)
  semester   Int
  credits    Int
  grade      String
  gpa        Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, semester])
  @@index([userId, source])
  @@index([userId, subject])
}

model GradeData {
  id        String @id @default(uuid())
  studentId String @unique
  // Order 11 (V-15 → P6): subjects blob KEPT during expand-phase dual-write
  // transition (canonical record is Grade rows with source=CALCULATOR; see
  // Grade comment). Writers fill BOTH blob + rows (routes/grades.ts);
  // readers prefer rows with blob fallback. Contract (drop subjects) is a
  // LATER order once reconciliation is green — do NOT drop here.
  subjects  String @default("[]")
  scale     String @default("10")
  // Order 11 (V-31): missing timestamps added (mutable 1–1 profile).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Course {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  credits     Int          @default(3)
  teacherId   String?
  collegeId   String?
  semester    String?
  teacher     User?        @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  college     College?     @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  grades      Grade[]
  assignments Assignment[]
  tasks       Task[]
  assignmentHubs AssignmentHub[]

  createdAt DateTime @default(now())
  // Order 12 tail (P10): missing updatedAt added (mutable: name/credits/
  // teacher/college reassignment). Backfill via DEFAULT in migration.
  updatedAt DateTime @updatedAt

  @@index([collegeId])
  @@index([teacherId])
  @@index([collegeId, semester])
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  student    User     @relation(fields: [studentId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  // Order 8 (V-22): absolute range alongside legacy date+String pair.
  // date stays the day bucket; startAt/endAt are the queryable range
  // (TIMESTAMPTZ). Dual-write in routes/tasks.ts via combineDateAndTime().
  // Ordering migrates to startAt; String cols kept until contract.
  startAt     DateTime?
  endAt       DateTime?
  duration    Int?
  category    String   @default("personal")
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  completed   Boolean  @default(false)
  color       String?
  isClass     Boolean  @default(false)
  courseId    String?
  location    String?
  // Order 12 (V-23 keep-lite → P10): recurrence stays free-text String? (no
  // RecurrenceRule table, no DB CHECK). It is write-only today (no reader
  // filters/groups by it; tasks list by date/category/status). Intended
  // RRULE-lite grammar when queries materialize:
  // NULL | ^(DAILY|WEEKLY|MONTHLY)(;INTERVAL=\d+)?(;COUNT=\d+)?$ (≤200 chars).
