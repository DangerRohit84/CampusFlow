model AttendanceData {
  id          String   @id @default(cuid())
  studentId   String   @unique
  // Order 11 (V-16 → P6/P9): subjects blob KEPT during expand-phase
  // dual-write transition (canonical record is AttendanceRecord rows; see
  // AttendanceRecord comment). Writers fill BOTH blob + rows
  // (routes/attendance.ts); readers prefer rows with blob fallback.
  // requiredPct stays here as the per-student low-attendance threshold for
  // "below-X%" queries over AttendanceRecord aggregates. Contract (drop
  // subjects) is a LATER order — do NOT drop here.
  subjects    String   @default("[]")
  requiredPct Int      @default(75)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Order 11 (V-31 → P8): redundant @@index([studentId]) DROPPED — @unique
  // already creates the index. (Five dup indexes tracked in Order 12 tail;
  // this one ships here with its violation.)
}

// Order 11 (V-16 → P6/P9): per-subject attendance as rows (one fact per row),
// replacing app-parse blob math + enabling SQL "below-X%" queries.
// Grain: one row per (student, subject) aggregate snapshot carrying the last
// event's date/status PLUS exact present/total counters. Backfilled from
// AttendanceData.subjects {name, held, attended} (date=CURRENT_DATE,
// status derived from pct vs requiredPct). New calculator saves replace-all
// per student (deleteMany + createMany, same as Order 10); a future daily
// marking endpoint can upsert per (studentId, subject, date) and maintain
// present/total incrementally — SUM(present)/SUM(total) GROUP BY subject
// stays the aggregate contract either way (see migration reconciliation).
// Task shorthand "(student+date+status)" + audit "(student,subject,present,
// total)" are both present here (superset, no divergence: counters are the
// record, date/status the last-event projection, not a second truth).
enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  subject   String
  date      DateTime         @default(now()) @db.Date
  status    AttendanceStatus @default(PRESENT)
  present   Int              @default(0)
  total     Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject])
  @@index([studentId])
  @@index([studentId, subject])
  @@index([studentId, date])
}

