generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String   @default("STUDENT")
  collegeId      String?
  collegeName    String?
  studentId      String?  @unique
  empNumber      String?  @unique
  departmentId   String?
  departmentName String?
  incomingYear   Int?
  outgoingYear   Int?
  avatar         String?
  preferences    String?  @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  schedules     Schedule[]
  notifications Notification[]
  assignments   Assignment[]
  grades        Grade[]

  chatSessions            ChatSession[]
  integrations            UserIntegration[]
  tasks                   Task[]
  college                 College?                 @relation(fields: [collegeId], references: [id])
  department              Department?              @relation(fields: [departmentId], references: [id])
  hackathonsCreated       Hackathon[]              @relation("HackathonCreator")
  registrations           HackathonRegistration[]
  formsCreated            Form[]
  formResponses           FormResponse[]
  teachingCourses         Course[]
  enrollments             Enrollment[]
  createdRooms            Room[]
  joinedRooms             RoomMember[]
  uploadedResources       Resource[]
  roomNotifications       RoomNotification[]
  roomMessages            RoomMessage[]
  roomChatPermissions     RoomChatAllowedMember[]
  messageHides            MessageHide[]
  messageReactions        MessageReaction[]
  internships             Internship[]
  internshipRegistrations InternshipRegistration[]
  codingContests          CodingContest[]
  codingProfile           CodingProfile?
  contestParticipations   ContestParticipation[]
  hackathonStagings       HackathonStaging[]       @relation("HackathonStagingCreator")
  internshipStagings      InternshipStaging[]      @relation("InternshipStagingCreator")
  attendanceData          AttendanceData?
  gradeData               GradeData?
   announcementsCreated    Announcement[]
  announcementReads     AnnouncementRead[]
  roomReads           RoomRead[]
}

model CodingProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  leetcodeHandle   String?
  codeforcesHandle String?
  codechefHandle   String?
  hackerrankHandle String?
  gfgHandle        String?
  platformStats    String?
  lastSyncedAt     DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContestParticipation {
  id             String    @id @default(uuid())
  userId         String
  contestId      String?
  platform       String
  contestName    String
  contestUrl     String?
  rank           Int?
  score          Int?
  rating         Int?
  ratingChange   Int?
  problemsSolved Int?
  totalProblems  Int?
  participatedAt DateTime?
  syncedAt       DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, contestName])
}

model Schedule {
  id        String   @id @default(cuid())
  userId    String
  title     String
  course    String?
  location  String?
  teacher   String?
  dayOfWeek Int
  startTime String
  endTime   String
  type      String   @default("CLASS")
  color     String?
  recurring Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("GENERAL")
  priority  String   @default("MEDIUM")
  read      Boolean  @default(false)
  source    String?
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("PENDING")
  priority    String   @default("MEDIUM")
  progress    Int      @default(0)
  grade       String?
  maxGrade    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Grade {
  id         String   @id @default(uuid())
  userId     String
  courseId   String?
  courseName String
  semester   Int
  credits    Int
  grade      String
  gpa        Float
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id])
}

model GradeData {
  id        String @id @default(uuid())
  studentId String @unique
  subjects  String @default("[]")
  scale     String @default("10")

  user User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Course {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  credits     Int          @default(3)
  teacherId   String
  collegeId   String?
  semester    String?
  teacher     User         @relation(fields: [teacherId], references: [id])
  college     College?     @relation(fields: [collegeId], references: [id])
  enrollments Enrollment[]
  grades      Grade[]

  createdAt DateTime @default(now())
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  student    User     @relation(fields: [studentId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  date        DateTime
  startTime   String?
  endTime     String?
  duration    Int?
  category    String   @default("personal")
  priority    String   @default("MEDIUM")
  status      String   @default("PENDING")
  completed   Boolean  @default(false)
  color       String?
  isClass     Boolean  @default(false)
  courseId    String?
  location    String?
  recurrence  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model UserIntegration {
  id           String    @id @default(uuid())
  userId       String
  type         String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model College {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  address    String?
  phone      String?
  website    String?
  logo       String?
  adminEmail String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users              User[]
  hackathons         Hackathon[]
  forms              Form[]
  courses            Course[]
  departments        Department[]
  internships        Internship[]
  codingContests     CodingContest[]
  hackathonStagings  HackathonStaging[]
  internshipStagings InternshipStaging[]
  announcements      Announcement[]
  announcementColleges AnnouncementCollege[]
}

model Department {
  id        String   @id @default(uuid())
  name      String
  collegeId String
  createdAt DateTime @default(now())

  college              College                  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users                User[]
  announcements        AnnouncementDepartment[]

  @@unique([collegeId, name])
}

model Hackathon {
  id                 String    @id @default(uuid())
  creatorId          String
  collegeId          String?
  title              String
  description        String?
  url                String?
  organizer          String?
  registrationUrl    String?
  startDate          DateTime?
  endDate            DateTime?
  deadline           DateTime?
  teamSize           Int?
  themes             String?   @default("[]")
  location           String?
  mode               String?   @default("OFFLINE")
  eligibility        String?   @default("{}")
  prizePool          String?
  duration           String?
  schedule           String?
  bootcamps          String?   @default("[]")
  highlights         String?   @default("[]")
  targetDepartments  String?   @default("[]")
  targetYears        String?   @default("[]")
  eligibilityEnabled Boolean   @default(false)
  website            String?
  discord            String?
  participantsCount  Int       @default(0)
  inviteOnly         Boolean   @default(false)
  status             String    @default("DRAFT")
  source             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creator       User                    @relation("HackathonCreator", fields: [creatorId], references: [id])
  college       College?                @relation(fields: [collegeId], references: [id])
  registrations HackathonRegistration[]
  rounds        HackathonRound[]
}

model HackathonRegistration {
  id           String   @id @default(uuid())
  hackathonId  String
  userId       String
  teamName     String?
  teamMembers  String?
  projectIdea  String?
  status       String   @default("REGISTERED")
  currentRound Int      @default(0)
  winPosition  String? // 1st, 2nd, 3rd, or "Completed" if no position
  review       String? // Student's review after final round
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
}

model HackathonRound {
  id          String    @id @default(uuid())
  hackathonId String
  roundNumber Int
  title       String
  description String?
  date        DateTime?
  resultDate  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, roundNumber])
}

model HackathonStaging {
  id                 String    @id @default(uuid())
  creatorId          String
  collegeId          String?
  title              String
  description        String?
  url                String?
  organizer          String?
  registrationUrl    String?
  startDate          DateTime?
  endDate            DateTime?
  deadline           DateTime?
  teamSize           Int?
  themes             String?   @default("[]")
  location           String?
  mode               String?   @default("OFFLINE")
  eligibility        String?   @default("{}")
  prizePool          String?
  duration           String?
  schedule           String?
  bootcamps          String?   @default("[]")
  highlights         String?   @default("[]")
  targetDepartments  String?   @default("[]")
  targetYears        String?   @default("[]")
  eligibilityEnabled Boolean   @default(false)
  website            String?
  discord            String?
  participantsCount  Int       @default(0)
  inviteOnly         Boolean   @default(false)
  status             String    @default("DRAFT")
  source             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creator User     @relation("HackathonStagingCreator", fields: [creatorId], references: [id])
  college College? @relation(fields: [collegeId], references: [id])
}

model InternshipStaging {
  id                 String   @id @default(uuid())
  creatorId          String
  collegeId          String?
  title              String
  description        String
  company            String
  role               String
  url                String
  stipend            String?
  duration           String?
  mode               String   @default("REMOTE")
  startDate          String?
  deadline           String?
  targetDepartments  String   @default("[]")
  targetYears        String   @default("[]")
  eligibilityEnabled Boolean  @default(false)
  status             String   @default("ACTIVE")
  source             String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  creator User     @relation("InternshipStagingCreator", fields: [creatorId], references: [id])
  college College? @relation(fields: [collegeId], references: [id])
}

model Internship {
  id                 String                   @id @default(uuid())
  creatorId          String
  collegeId          String
  title              String
  description        String
  company            String
  role               String
  url                String
  stipend            String?
  duration           String?
  mode               String                   @default("REMOTE")
  startDate          String?
  deadline           String?
  targetDepartments  String                   @default("[]")
  targetYears        String                   @default("[]")
  eligibilityEnabled Boolean                  @default(false)
  status             String                   @default("ACTIVE")
  source             String?
  createdAt          DateTime                 @default(now())
  creator            User                     @relation(fields: [creatorId], references: [id])
  college            College                  @relation(fields: [collegeId], references: [id])
  registrations      InternshipRegistration[]
}

model InternshipRegistration {
  id           String     @id @default(uuid())
  internshipId String
  userId       String
  status       String     @default("REGISTERED")
  reportedAt   DateTime?
  internship   Internship @relation(fields: [internshipId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@unique([internshipId, userId])
}

model CodingContest {
  id            String   @id @default(uuid())
  title         String
  platform      String
  url           String
  startTime     String
  duration      Int?
  contestType   String?
  status        String   @default("UPCOMING")
  solutions     String   @default("[]")
  isAutoFetched Boolean  @default(false)
  creatorId     String?
  collegeId     String?
  createdAt     DateTime @default(now())
  creator       User?    @relation(fields: [creatorId], references: [id])
  college       College? @relation(fields: [collegeId], references: [id])
}

model Form {
  id                 String    @id @default(uuid())
  creatorId          String
  collegeId          String?
  title              String
  description        String?
  status             String    @default("ACTIVE")
  allowEdit          Boolean   @default(false)
  expiresAt          DateTime?
  targetDepartments  String    @default("[]")
  targetYears        String    @default("[]")
  eligibilityEnabled Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  creator   User           @relation(fields: [creatorId], references: [id])
  college   College?       @relation(fields: [collegeId], references: [id])
  fields    FormField[]
  responses FormResponse[]
  formRooms FormRoom[]
}

model FormRoom {
  id        String   @id @default(uuid())
  formId    String
  roomId    String
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([formId, roomId])
  @@index([formId])
  @@index([roomId])
}

model FormField {
  id        String   @id @default(uuid())
  formId    String
  label     String
  type      String   @default("TEXT")
  required  Boolean  @default(false)
  options   String?  @default("[]")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormResponse {
  id          String   @id @default(uuid())
  formId      String
  userId      String
  answers     String   @default("{}")
  submittedAt DateTime @default(now())

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formId, userId])
}

model Room {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  joinCode    String   @unique
  teacherId   String
  chatMode    String   @default("EVERYONE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher            User                    @relation(fields: [teacherId], references: [id])
  members            RoomMember[]
  resources          Resource[]
  notifications      RoomNotification[]
  formRooms          FormRoom[]
  messages           RoomMessage[]
  chatAllowedMembers RoomChatAllowedMember[]
  reads              RoomRead[]

  @@index([teacherId])
  @@index([joinCode])
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  studentId String
  isCR      Boolean  @default(false)
  joinedAt  DateTime @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([roomId, studentId])
  @@index([roomId])
  @@index([studentId])
}

model RoomMessage {
  id          String    @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  fileUrl     String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  isForwarded Boolean   @default(false)
  replyToId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room     Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender   User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo  RoomMessage?      @relation("RoomMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  RoomMessage[]     @relation("RoomMessageReplies")
  hides    MessageHide[]
  reactions MessageReaction[]

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([replyToId])
}

model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String   @db.VarChar(8)
  createdAt DateTime @default(now())

  message RoomMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model RoomChatAllowedMember {
  id        String   @id @default(uuid())
  roomId    String
  userId    String
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
}

model Resource {
  id              String   @id @default(uuid())
  title           String
  description     String   @default("")
  fileUrl         String
  fileType        String   @default("other") // pdf, ppt, link, other
  category        String   @default("other") // lecture, assignment, reference, other
  fileSize        Int?
  sourceMessageId String?  // set when the resource was shared via a room chat attachment
  roomId          String
  uploadedBy      String
  createdAt       DateTime @default(now())

  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploadedBy], references: [id])

  @@index([roomId])
  @@index([uploadedBy])
}

model RoomNotification {
  id          String   @id @default(uuid())
  roomId      String
  studentId   String
  message     String
  resourceUrl String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@index([studentId])
  @@index([isRead])
}

model PlatformSettings {
  id          String    @id @default(cuid())
  platform    String
  type        String
  fetchLimit  Int       @default(0)
  lastFetchAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([platform, type])
  @@map("platform_settings")
}

model AttendanceData {
  id          String   @id @default(cuid())
  studentId   String   @unique
  subjects    String   @default("[]")
  requiredPct Int      @default(75)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

enum AnnouncementTarget {
  ALL_DEPARTMENTS
  SPECIFIC_DEPARTMENTS
}

enum AnnouncementTargetScope {
  ALL_COLLEGES
  SPECIFIC_COLLEGES
  MY_COLLEGES
}

model Announcement {
  id          String                  @id @default(uuid())
  title       String                  @db.VarChar(200)
  content     String                  @db.Text
  target      AnnouncementTarget      @default(ALL_DEPARTMENTS)
  targetScope AnnouncementTargetScope @default(MY_COLLEGES)
  creatorId   String
  collegeId   String?
  publishAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  creator      User                     @relation(fields: [creatorId], references: [id])
  college      College?                 @relation(fields: [collegeId], references: [id])
  departments  AnnouncementDepartment[]
  colleges     AnnouncementCollege[]
  reads        AnnouncementRead[]

  @@index([collegeId, createdAt])
  @@index([targetScope, createdAt])
}

model AnnouncementDepartment {
  id             String       @id @default(uuid())
  announcementId String
  departmentId   String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([announcementId, departmentId])
  @@index([announcementId])
  @@index([departmentId])
}

model AnnouncementCollege {
  id             String   @id @default(uuid())
  announcementId String
  collegeId      String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  college      College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, collegeId])
  @@index([announcementId])
  @@index([collegeId])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
}

model RoomRead {
  id         String   @id @default(uuid())
  roomId     String
  userId     String
  lastReadAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
}

model AiProvider {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  apiKey    String
  model     String
  type      String   @default("openai-compatible")
  headers   String?
  enabled   Boolean  @default(true)
  isBuiltIn Boolean  @default(false)
  collegeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routings AiRouting[]

  @@unique([name, collegeId])
}

model AiRouting {
  id            String     @id @default(cuid())
  feature       String
  providerId    String
  provider      AiProvider @relation(fields: [providerId], references: [id])
  fallbackOrder Int
  collegeId     String?
  createdAt     DateTime   @default(now())

  @@unique([feature, fallbackOrder, collegeId])
}
