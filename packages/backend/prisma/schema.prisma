model RoomMessage {
  id          String    @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  fileUrl     String?
  fileName    String?
  fileType    String?
  fileSize    Int?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  isForwarded Boolean   @default(false)
  replyToId   String?
  // Threads-lite (#8): replyToId doubles as the thread parent (no separate
  // parentId column — quote-replies ARE the thread children; reply counts come
  // from the replies relation). Pins are first-class columns below.
  // Order 12 (V-28 keep-lite): no MessagePin extraction — pinned bar query
  // (roomId + isPinned, cap MAX_PINNED_PER_ROOM=20 in routes/rooms.ts) is
  // served by @@index([roomId, isPinned]); low-cardinality boolean composite
  // is acceptable at current scale (partial WHERE "isPinned" index only past
  // ~1M rows, P8). Extract MessagePin(messageId, pinnedBy, pinnedAt) only if
  // pin history/audit is required (in-row keeps last pin only by design).
  // Delete policy (P10 tail): hard-delete + cascade everywhere EXCEPT
  // RoomMessage soft-delete (isDeleted/deletedAt, visible via [roomId,
  // isDeleted]); audit coverage via AuditLog (append-only, FK-less by design).
  isPinned    Boolean   @default(false)
  pinnedAt    DateTime?
  pinnedBy    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  room     Room              @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender   User              @relation("RoomMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  pinnedByUser User?         @relation("RoomMessagePinnedBy", fields: [pinnedBy], references: [id], onDelete: SetNull)
  replyTo  RoomMessage?      @relation("RoomMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  RoomMessage[]     @relation("RoomMessageReplies")
  hides    MessageHide[]
  reactions MessageReaction[]
  resources Resource[] @relation("ResourceSourceMessage")

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([roomId, isDeleted])
  @@index([roomId, isPinned])
  @@index([pinnedBy])
}

