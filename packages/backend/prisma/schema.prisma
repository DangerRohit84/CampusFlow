// Per-college independent staging decisions (fix: single global status).
// WHY: HackathonStaging/InternshipStaging.status was global — College A
// APPROVE flipped the row to APPROVED so College B never saw it as pending
// (and REJECT hid it from everyone). @@unique(title,source) stays GLOBAL on
// purpose (one shared feed row, no per-college duplicates); per-college
// visibility lives here: (stagingId, collegeId) unique, decision
// APPROVED/REJECTED, by/at audit. Global row keeps PENDING/DRAFT/ACTIVE;
// each college's approve creates its OWN published copy + own APPROVED row,
// reject records own REJECTED row only. Lists: pending = no decision by my
// college (plus legacy global-status check for pre-migration rows).
// Deploy: additive tables only (`prisma migrate deploy`); runtime guards
// `(prisma as any).xxxDecision?` + try/catch so pre-migration returns
// legacy behavior instead of 500 (SourceHealth pattern).
// Order 4 (V-30): decision is native StagingDecision enum (APPROVED/REJECTED;
// pending = absence, no PENDING row). (collegeId, decision) composite serves
// "my APPROVED / my REJECTED" lists; pending uses anti-join NOT decisions
// some collegeId (see staging.ts buildStagingWhere) + existing (collegeId)
// + unique(stagingId, collegeId). Order 12: decidedAt+createdAt twins KEPT —
// NOT redundant: createdAt = first decision (immutable), decidedAt = last
// decision (bumped on every upsert in decisions.ts + hackathons/internships
// approve paths; no reader selects decidedAt yet, but writers depend on it).
// Dropping either would break writes or lose first-vs-last semantics; keep both.
model HackathonStagingDecision {
  id        String   @id @default(uuid())
  stagingId String
  collegeId String
  decision  StagingDecision
  decidedBy String?
  decidedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staging HackathonStaging @relation(fields: [stagingId], references: [id], onDelete: Cascade)
  college College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  decider User?            @relation("HackathonDecisionBy", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@unique([stagingId, collegeId])
  @@index([collegeId])
  @@index([stagingId])
  @@index([decidedBy])
  @@index([collegeId, decision])
  @@map("HackathonStagingDecision")
}

