enum AssignmentScope {
  ALL
  DEPARTMENT
  ROOM
}

enum SubmissionMode {
  ONLINE
  OFFLINE
  HYBRID
}

model AssignmentHub {
  id                   String         @id @default(uuid())
  title                String         @db.VarChar(200)
  description          String?        @db.Text
  courseId             String?
  dueDate              DateTime
  creatorId            String
  collegeId            String?
  // Order 5 (V-27): polymorphic scope enforced by DB CHECK
  // chk_assignmenthub_scope (see migration 20260922000000_order5_9):
  // (ALL AND dept NULL AND room NULL) OR (DEPARTMENT AND dept NOT NULL AND
  // room NULL) OR (ROOM AND room NOT NULL AND dept NULL). App mirrors in
  // validators.ts isValidAssignmentScope + routes/assignmentHub.ts 400s.
  scope                AssignmentScope @default(ALL)
  departmentId         String?
  roomId               String?
  submissionMode       SubmissionMode  @default(ONLINE)
  showGrades           Boolean         @default(true)
  showFeedback         Boolean         @default(true)
  showSubmissionStatus Boolean         @default(true)
  showStats            Boolean         @default(false)
  maxPoints            Int             @default(100)
  maxGrade             String?
  allowLateSubmission  Boolean         @default(false)
  attachments          String?         @default("[]")
  // Order 10 (V-17): attachments blob KEPT during dual-write transition.
  // Canonical per-file rows: AssignmentAttachment (assignmentId → here
  // Cascade; url/fileName/fileType/fileSize/"order"). Writers fill both
  // (routes/assignmentHub.ts); readers prefer attachmentRows with blob
  // fallback. Contract (drop blob) is a later order — do NOT drop here.
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  creator    User       @relation("AssignmentHubCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  college    College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  course     Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  submissions AssignmentSubmission[]
  attachmentRows AssignmentAttachment[]

  @@index([collegeId, scope])
  @@index([departmentId])
  @@index([roomId])
  @@index([creatorId])
  @@index([dueDate])
  @@index([collegeId, dueDate])
  @@index([scope, dueDate])
  @@index([courseId])
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String
  studentId    String
  content      String?  @db.Text
  fileUrl      String?
  fileName     String?
  fileType     String?
  fileSize     Int?
  status       SubmissionStatus @default(SUBMITTED)
  grade        String?
  points       Int?
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())
  gradedAt     DateTime?
  gradedBy     String?
  // offline marking support — teacher can mark paper submissions via same UI
  submissionChannel SubmissionMode @default(ONLINE)
  offlineNote       String?  @db.Text
  offlineVerifiedBy String?
  offlineVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment AssignmentHub @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grader     User?         @relation("SubmissionGrader", fields: [gradedBy], references: [id], onDelete: SetNull)
  offlineVerifier User?    @relation("SubmissionOfflineVerifier", fields: [offlineVerifiedBy], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
  @@index([submissionChannel])
  // Order 12 tail (P8): redundant @@index([assignmentId, studentId]) DROPPED —
  // duplicates @@unique (unique already indexes the pair; planner keeps it).
  // Ranked cause #4 roster/count path stays covered by the unique + the two
  // single-column FK indexes above.
}

// Order 10 (V-17 → P9): 4NF child table for hub attachments (one fact per
// row), mirroring Resource-per-file shape. Blob `AssignmentHub.attachments`
// (JSON array of URL strings) stays during transition. "order" preserves
// upload order for display. Backfill in migration 20260923000000_order10.
model AssignmentAttachment {
  id           String   @id @default(uuid())
  assignmentId String
  url          String
  fileName     String?
  fileType     String?
  fileSize     Int?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  assignment AssignmentHub @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([assignmentId, order])
}

// Order 2 V-25 NULL-trap fix: @@unique([name, collegeId]) allows duplicate
// global (NULL collegeId) names because NULL!=NULL. Enforced by partial
// UNIQUE INDEX "AiProvider_name_global_unique" ON "AiProvider"("name")
// WHERE "collegeId" IS NULL (see migration 20260919000000_order2_nullsafe_uniques).
// collegeId stays nullable (NULL = global provider); per-tenant rows use the
// composite @@unique. Same pattern for AiRouting below.
// Order 9 (V-19): headers String? → Json? (JSONB object of extra HTTP headers).
// Readers handle Json|String via parseHeadersSafe; writers pass objects.
model AiProvider {
  id        String   @id @default(cuid())
  name      String
  baseUrl   String
  apiKey    String
  model     String
  type      String   @default("openai-compatible")
  headers   Json?
  enabled   Boolean  @default(true)
  isBuiltIn Boolean  @default(false)
  collegeId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  routings AiRouting[]

  @@unique([name, collegeId])
  @@index([collegeId])
  @@index([headers], type: Gin, map: "AiProvider_headers_gin")
}

// Order 2 V-25 (AiRouting): @@unique([feature, fallbackOrder, collegeId]) has the
// same NULL trap for global routings. Partial UNIQUE INDEX
// "AiRouting_feature_order_global_unique" ON "AiRouting"("feature", "fallbackOrder")
// WHERE "collegeId" IS NULL closes it (see same migration).
model AiRouting {
  id            String     @id @default(cuid())
  feature       String
  providerId    String
  provider      AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  fallbackOrder Int
  collegeId     String?
  createdAt     DateTime   @default(now())

  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@unique([feature, fallbackOrder, collegeId])
  @@index([providerId])
  @@index([feature])
  @@index([collegeId])
}

model Report {
  id            String   @id @default(uuid())
  userId        String
  collegeId     String?
  scope         ReportScope      @default(WEBSITE)
  issueType     ReportIssueType
  title         String   @db.VarChar(200)
  description   String   @db.Text
  priority      Priority         @default(MEDIUM)
  status        ReportStatus     @default(OPEN)
  attachmentUrl String?
  // Order 6 (V-20): collegeName display copy DROPPED — resolve via college
  // relation (include college { select name }). API keeps `collegeName` key as
  // projection for compat (see routes/reports.ts).
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId, status])
  @@index([userId])
  @@index([scope])
  @@index([status])
  @@index([createdAt])
  @@index([issueType])
  @@index([priority])
}

// Prod P0 auth hardening stub (jti revocation + login-attempt audit).
// Middleware currently uses in-memory Set/Map (see utils/authHardening.ts) for
// single-instance correctness; these tables persist the same data when
// multi-replica (Render) lands. Migration pending — run `prisma migrate dev`
// after review; until then the in-memory stub is authoritative.
model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// #11 bulk CSV (dry-run) + audit log UI + AI metering/cost caps + platform KPIs.
// Additive only (deploy applies via `prisma migrate deploy`). All new tables are
// optional at runtime — routes/services guard with `(prisma as any).xxx?` +
// try/catch so pre-migration deploys return empty/fallback instead of 500
// (same pattern as SourceHealth / SyncThrottle).
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  collegeId  String?
  // Order 9 (V-19): String? → Json? (JSONB object, caller-built diff payload).
  // buildAuditMetadata now returns an object (not a JSON string); recordAudit
  // accepts object|String for rollout compat. GIN for future field queries;
  // proper AuditLogField child table is Order 10+.
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  college College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  @@index([collegeId, createdAt])
  @@index([action, createdAt])
  @@index([actorId])
  @@index([createdAt])
  @@index([collegeId])
  @@index([metadata], type: Gin, map: "AuditLog_metadata_gin")
  @@map("AuditLog")
}

// Per-college per-feature daily AI counters (requests/tokens/cost).
// Written best-effort from aiQuota middleware (fire-and-forget, never blocks).
// Order 8 (V-32): day String (producer-discipline "YYYY-MM-DD") + dayDate DATE
// (typed, queryable). Dual-write via dayBucket()/dayDateFromBucket(); unique
// stays on day until contract, new unique on dayDate added alongside.
// Ordering/range uses dayDate; String kept until contract (Order 12).
model AiUsage {
  id        String   @id @default(uuid())
  collegeId String
  feature   String
  day       String
  dayDate   DateTime? @db.Date
  requests  Int      @default(0)
  tokens    Int      @default(0)
  costCents Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Restrict)

  @@unique([collegeId, feature, day])
  @@unique([collegeId, feature, dayDate], map: "AiUsage_college_feature_dayDate_unique")
  @@index([collegeId, day])
  @@index([day])
  @@index([dayDate])
  @@index([collegeId, dayDate])
  @@map("AiUsage")
}

// Per-college AI budget caps (SUPER_ADMIN editable via /ai-manager/quota).
// dailyTokenCap defaults to the in-memory 10k/day (see middleware/aiQuota.ts).
model AiQuota {
  collegeId          String   @id
  dailyTokenCap      Int      @default(10000)
  monthlyTokenCap    Int?
  totalCostCapCents  Int?
  enabled            Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@map("AiQuota")
}
