# CampusFlow API — required prod env (placeholders only, never commit live values).
# Fail-closed boot (see src/config/envValidation.ts + src/config/storage.ts):
#   DATABASE_URL, DIRECT_URL, JWT_SECRET, AI_ENCRYPTION_KEY, FRONTEND_URL,
#   CLOUDINARY_* x3 break prod when missing/weak; CRON_SECRET unset → /internal/cron/* 503.
# Render parity (see render.yaml campusflow-api envVars): same keys + REDIS_URL (fromService),
#   GROQ_API_KEY (sync:false), DISABLE_EMBEDDED_CRON=true, NODE_ENV=production.
# Generate secrets locally: openssl rand -hex 32. Live values live in Render Dashboard only.

# Database (Neon required — pooled for runtime, direct for `prisma migrate deploy`).
# Pooled keeps Render + Neon warm; direct bypasses the pooler for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30&pgbouncer=true&connection_limit=50&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30"

# Auth (min 32 chars each — placeholders below pass length check, contain no secrets).
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_JWT_SECRET_64ch
AI_ENCRYPTION_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32_AI_KEY_64ch

# Frontend origin allowlist SSOT (CORS + Socket.IO, no localhost fallback in prod).
# Dual-serve Vercel cutover: comma-separated, e.g. https://campusflow-web.onrender.com,https://campusflow.vercel.app
FRONTEND_URL=http://localhost:3000

# File storage (all three required in prod — Render disk is ephemeral, storage.ts throws without them).
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# Internal cron auth (any high-entropy value locally; single source = API generateValue in prod).
CRON_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_CRON_64chars

# ---- Optional (defaults work, uncomment to override) ----
# Auth/session tuning:
#JWT_EXPIRES_IN=1d
# Extra origins csv (combined with FRONTEND_URL, never `*` in prod).
#FRONTEND_URLS=
# Server:
#NODE_ENV=development
#PORT=4000
#LOG_LEVEL= # pino level (default debug in dev, info in prod): debug|info|warn|error
# Cache/scale-out (single-instance OK unset; multi-instance needs shared Redis):
#REDIS_URL= # e.g. redis://localhost:6379 local, rediss://... prod TLS (never log this value)
#SOCKET_ADAPTER= # redis|memory|auto (default auto: redis when REDIS_URL set, else memory)
# AI (backend proxy only — unset = AI_DISABLED fallback, no throw):
#GROQ_API_KEY=
# Crons (prod: DISABLE_EMBEDDED_CRON=true, Render Cron Jobs own schedules):
#DISABLE_EMBEDDED_CRON=false
#SKIP_CONTEST_BOOT_FETCH=false # fast-local: skip boot contest fetch; prod keeps false to warm Neon
# DB observability (10k tuning):
#SLOW_QUERY_MS=500
#DB_METRICS_INTERVAL_MS=60000
#MIN_CONNECTION_LIMIT=50 # raise-only floor, never lowers below 50 at 10k
# Profile-sync sharding (10k tuning):
#SYNC_SHARD_SIZE=500
#SYNC_PAGE_SIZE=200
#SYNC_TIME_BUDGET_MS=2700000
#SYNC_INTER_BATCH_DELAY_MS=0
# Demo seeds (local only — NEVER true in prod):
#SEED_DEMO_CONTESTS=
#SEED_DEMO_USERS=
# Contest enrichment (best-effort, no throw when unset):
#YOUTUBE_API_KEY=
# OpenCode Zen routing (all unset = disabled, no throw):
#OPENCODE_ZEN_API_KEY=
#OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
#OPENCODE_SERVE_URL=
# Hardening flags (boot warns in prod when insecure default — see envValidation.ts):
#HIBP_STRICT=false # prod wants true (fail-closed breached-password check)
#UPLOAD_SCAN_STRICT=false # prod wants true (reject uploads when sniffing unavailable)
#CLAMAV_URL= # future wiring only (not read yet — heuristic scan is current enforcement)
#EXTERNAL_FETCH_ALLOWLIST= # prod fallback: 10 platform suffixes when unset
#TURNSTILE_SECRET=
#TURNSTILE_ENFORCE=false # prod bot defense wants true
# Cron tenant debug only (unset = global null feed):
#CRON_COLLEGE_ID=
# Auto-fetch master toggle (DB-backed FetchConfig is authoritative; leave unset
# so the SUPER_ADMIN FetchPage switch works without redeploy. Set false ONLY as
# an emergency ops kill-switch — it overrides the DB value at runtime.
# Manual POST /fetch/* always works regardless of this flag):
#AUTO_FETCH_ENABLED=true
# Frontend build-time vars live in apps/web/.env.example + Vercel dashboard (never here):
# VITE_API_URL, VITE_SITE_URL. FORBIDDEN everywhere: VITE_GROQ_API_KEY must NEVER be set
# (Vite embeds VITE_* in the client bundle — prod AI path is the backend proxy only).
