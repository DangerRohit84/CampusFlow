# Database (PostgreSQL - Neon recommended; append pooling params to avoid cold-start latency)
# For Neon pooler add: &pgbouncer=true&connection_limit=10&pool_timeout=10
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/campusflow?sslmode=require&connect_timeout=15&pgbouncer=true&connection_limit=10"

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# AI APIs
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
NODE_ENV=development
PORT=4000

# AI Manager - API key encryption (min 32 chars)
AI_ENCRYPTION_KEY=your-secret-encryption-key-at-least-32-chars

# Internal cron endpoints (Render Cron Jobs trigger these over HTTP)
# REQUIRED in every environment - endpoints fail closed with 503 when unset,
# including local dev. Set any high-entropy value locally to use them.
CRON_SECRET=your-cron-secret-here
# Set to true in production to disable in-process cron schedules
DISABLE_EMBEDDED_CRON=false

# Neon-style connection string shape (Neon free tier recommended for dev and prod)
NEON_CONNECTION_STRING_EXAMPLE="postgresql://USER:PASSWORD@ep-example-123456.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&connect_timeout=15"

# Cloudinary - production file storage (optional).
# When all three are set, uploads go to Cloudinary; otherwise local uploads/ disk is used.
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here
