# Database (PostgreSQL - Neon required; pooled URL keeps Render + Neon warm)
# DATABASE_URL = POOLED (-pooler host) + pgbouncer=true for runtime queries
# DIRECT_URL  = DIRECT (no -pooler, no pgbouncer) for `prisma migrate deploy` / `db push`
# Both are required when using Neon; see prisma/schema.prisma datasource `directUrl`.
# NOTE: channel_binding=prefer (not require) fixes P1001 on some networks/VPCs.
# connect_timeout=30 + pool_timeout=30 gives Neon pooler time to wake from idle.
# 10k scale: connection_limit=50 (was 20) — headroom for burst + socket fan-out without P2024.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30&pgbouncer=true&connection_limit=50&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30"

# Authentication
# DO NOT put live values here. Generate locally: openssl rand -hex 32 (64 chars).
# Placeholders below are 64-char REPLACE_ME_ strings (pass length check, fail gitleaks-safe).
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_JWT_SECRET_64ch
JWT_EXPIRES_IN=1d

# Auth hardening (fail-closed flags — see src/utils/authHardening.ts + uploadScan.ts)
# HIBP_STRICT=true (prod REQUIRED): breached-password check fails CLOSED when
#   api.pwnedpasswords.com is offline/error (treat as breached → 400).
#   Default false = dev fail-open with warn log. Boot warns in prod when !=true.
#   See src/config/envValidation.ts + .ai/reports/deploy-readiness.md matrix.
#HIBP_STRICT=false
# UPLOAD_SCAN_STRICT=true (prod REQUIRED): reject uploads when file-type sniffing
#   is unavailable (fail-closed). Default false = allow .txt/small-office fallback
#   + heuristic scan only. Boot warns in prod when !=true.
#   Full ClamAV (clamdjs) / S3 Object Lambda + GuardDuty is a separate infra PR — see uploadScan.ts.
#UPLOAD_SCAN_STRICT=false
# CLAMAV_URL — placeholder for future ClamAV wiring (NOT read yet).
#   Heuristic scan + magic-byte gate is current enforcement (see uploadScan.ts).
#   Example (future): CLAMAV_URL=clamav://127.0.0.1:3310
#   Boot logs an advisory note when set (documents intent, no behavior change).
#CLAMAV_URL=

# External fetch allowlist (SSRF guard — see src/utils/secureUrl.ts).
# ALLOWLIST = EXTERNAL_FETCH_ALLOWLIST (comma-separated host suffixes).
# - Dev: unset = any public host allowed (convenient for local scraping).
# - Prod: unset = DEFAULT_FETCH_ALLOWLIST fallback (10 platform suffixes:
#   unstop.com, internshala.com, devpost.com, devfolio.co, dorahacks.io,
#   hack2skill.com, mlh.io, wellfound.com, reskilll.com, hackerearth.com).
#   Set explicitly to override. Boot warns in prod when unset (fallback noted).
#   Example: EXTERNAL_FETCH_ALLOWLIST=unstop.com,internshala.com,devpost.com
#EXTERNAL_FETCH_ALLOWLIST=

# Turnstile (Cloudflare CAPTCHA for auth/register — see src/utils/turnstile.ts).
# - TURNSTILE_SECRET: server secret for siteverify API (fail-closed in prod when
#   TURNSTILE_ENFORCE=true or when secret is set; dev fail-open with log).
# - TURNSTILE_ENFORCE=true: reject missing/invalid tokens even without secret
#   (prod bot defense). Default false = allow missing token with log (rollout).
#   Boot warns in prod when TURNSTILE_SECRET unset (CAPTCHA cannot verify).
#TURNSTILE_SECRET=
#TURNSTILE_ENFORCE=false

# Frontend site URLs (these live in render.yaml web envVars, listed here
# for the full matrix so first-deploy TODOs stay in one place).
# - VITE_API_URL: must match the live Singapore API (render.yaml campusflow-web
#   envVars + cron API_BASE_URL + api FRONTEND_URL/CSP connect-src together).
#   Example prod: https://campusflow-api.onrender.com
# - VITE_SITE_URL: canonical site URL for SEO (Seo.tsx + index.html og/canonical).
#   TODO(first-deploy): replace with real custom domain (e.g., https://campusflow.dev).
#   Example prod: https://campusflow-web.onrender.com
#VITE_API_URL=http://localhost:4000
#VITE_SITE_URL=http://localhost:3000

# AI APIs
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
NODE_ENV=development
PORT=4000

# AI Manager - API key encryption (min 32 chars)
AI_ENCRYPTION_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32_AI_KEY_64ch

# Internal cron endpoints (Render Cron Jobs trigger these over HTTP)
# REQUIRED in every environment - endpoints fail closed with 503 when unset,
# including local dev. Set any high-entropy value locally to use them.
CRON_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_CRON_64chars
# Set to true in production to disable in-process cron schedules
DISABLE_EMBEDDED_CRON=false
# Fast-local: skip boot-time contest fetch (tsx watch restarts on every save;
# each fetch fans out to ~30x CodingContest.findFirst + 3 external APIs —
# 30-60s block on IST→us-east-2). Set true in dev (.env.local.example);
# prod keeps false so Render cold start warms Neon. Manual refresh:
# POST /api/contests/fetch-now or POST /internal/cron/contests.
SKIP_CONTEST_BOOT_FETCH=false

# Neon pooled vs direct — copy from Neon dashboard:
# Pooled (for DATABASE_URL): ends with `-pooler` + add `&pgbouncer=true&connection_limit=50&pool_timeout=30`
# Direct (for DIRECT_URL): no `-pooler`, no pgbouncer params
# Rollback: if pooler still P1001, app retries explicitly via withRetry (db.ts) and health check
# exposes degraded status. To rollback URL, restore channel_binding=require but prefer is safer.
# To lower pool under memory pressure: set MIN_CONNECTION_LIMIT=20 (default floor is 50 for 10k).

# DB observability (10k tuning, all optional):
# SLOW_QUERY_MS=500 — log queries slower than this (see [db:slow] + [db:metrics] logs)
# DB_METRICS_INTERVAL_MS=60000 — pool metrics cadence
# MIN_CONNECTION_LIMIT=50 — floor enforced by sanitizeUrl (raise, never lower, at 10k)

# Cache / scale-out (10k multi-instance):
# - DEV/CI (single replica): leave unset → process-local memory fallback
#   (rate-limit + throttle + authorize + locks behave exactly as before).
# - PROD (N replicas): REQUIRED → shared Redis (Render Key Value `campusflow-cache`
#   in singapore via fromService connectionString, i.e. internal redis://red-xxx:6379;
#   external is rediss:// + IP allowlist). All replicas share rate-limit counters,
#   sync throttle, authorize cache, sync locks, socket presence. Without it each
#   replica counts alone (budget inflates N×, throttles double-fire).
#   Example local: REDIS_URL=redis://localhost:6379
#   Example prod (external): REDIS_URL=rediss://default:PASSWORD@HOST:6379 (TLS `rediss://`)
#   Fail-open: a Redis blip degrades to memory (over-admit by 1, never 500s).
#   Boot: warns (never crashes) when unset — prod warning notes multi-instance need.
#   Never log this value (secret). See .ai/reports/scale10k-redis.md env matrix.
#REDIS_URL=

# Cloudinary - production file storage (optional).
# When all three are set, uploads go to Cloudinary; otherwise local uploads/ disk is used.
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

