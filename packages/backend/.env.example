# Database (PostgreSQL - Neon required; pooled URL keeps Render + Neon warm)
# DATABASE_URL = POOLED (-pooler host) + pgbouncer=true for runtime queries
# DIRECT_URL  = DIRECT (no -pooler, no pgbouncer) for `prisma migrate deploy` / `db push`
# Both are required when using Neon; see prisma/schema.prisma datasource `directUrl`.
# NOTE: channel_binding=prefer (not require) fixes P1001 on some networks/VPCs.
# connect_timeout=30 + pool_timeout=30 gives Neon pooler time to wake from idle.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30&pgbouncer=true&connection_limit=20&pool_timeout=30"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.c-5.us-east-2.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30"

# Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# AI APIs
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
NODE_ENV=development
PORT=4000

# AI Manager - API key encryption (min 32 chars)
AI_ENCRYPTION_KEY=your-secret-encryption-key-at-least-32-chars

# Internal cron endpoints (Render Cron Jobs trigger these over HTTP)
# REQUIRED in every environment - endpoints fail closed with 503 when unset,
# including local dev. Set any high-entropy value locally to use them.
CRON_SECRET=your-cron-secret-here
# Set to true in production to disable in-process cron schedules
DISABLE_EMBEDDED_CRON=false

# Neon pooled vs direct — copy from Neon dashboard:
# Pooled (for DATABASE_URL): ends with `-pooler` + add `&pgbouncer=true&connection_limit=20&pool_timeout=30`
# Direct (for DIRECT_URL): no `-pooler`, no pgbouncer params
# Rollback: if pooler still P1001, app auto-retries (db.ts withRetry) and health check
# exposes degraded status. To rollback URL, restore channel_binding=require but prefer is safer.

# Cloudinary - production file storage (optional).
# When all three are set, uploads go to Cloudinary; otherwise local uploads/ disk is used.
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here
