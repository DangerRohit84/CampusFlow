# CampusFlow — fast local dev (.env.local.example)
# Copy to .env for local dev: copy .env.local.example .env  (then fill JWT/CRON placeholders)
# Goal: <50ms queries locally vs 1300-6100ms on IST→us-east-2 Neon.
#
# 1) LOCAL POSTGRES (recommended — <50ms, no RTT/TLS/wake)
#    docker compose up db -d        # starts postgres:16-alpine on 127.0.0.1:5432 (see /docker-compose.yml)
#    npx prisma migrate deploy      # uses DIRECT_URL below (direct, no pgbouncer)
#    npx prisma generate
#    npm run dev                    # tsx watch src/index.ts
DATABASE_URL="postgresql://campusflow:campusflow@localhost:5432/campusflow?sslmode=disable"
DIRECT_URL="postgresql://campusflow:campusflow@localhost:5432/campusflow?sslmode=disable"

# 2) CLOUD ALT (only if you must use Neon from India):
#    Create a Neon branch in ap-south-1 (Mumbai) — IST→Mumbai ~20-40ms vs IST→us-east-2 ~250-300ms.
#    Neon dashboard → Branches → New Branch → Region ap-south-1 → copy its pooled + direct URLs here.
#    Keep pooled params identical: ?sslmode=require&channel_binding=prefer&connect_timeout=30&pgbouncer=true&connection_limit=50&pool_timeout=30
#    Example shape (REPLACE with your ap-south-1 branch values, never commit live URLs):
#    DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.c-XXX.ap-south-1.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30&pgbouncer=true&connection_limit=50&pool_timeout=30"
#    DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.c-XXX.ap-south-1.aws.NEONHOST_REMOVED/campusflow?sslmode=require&channel_binding=prefer&connect_timeout=30"

# Auth (generate locally, never commit live values):
#   openssl rand -hex 32   (64 chars, satisfies >=32 check in src/config/index.ts)
JWT_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_JWT_LOCAL_64ch
JWT_EXPIRES_IN=7d

# Fast-local boot: skip auto contest fetch on `tsx watch` restart.
# Each boot fetch = 3 external APIs + ~30x CodingContest.findFirst (~1500ms each on us-east-2).
# Manual refresh when needed: POST /api/contests/fetch-now or POST /internal/cron/contests.
SKIP_CONTEST_BOOT_FETCH=true
# Keep embedded cron schedules on for local (6h contests / 12h opportunities / Sun cleanup).
# Set true only in prod web service (Render Cron Jobs hit /internal/cron/* instead).
DISABLE_EMBEDDED_CRON=false

# DB observability — SLOW 1000 locally to cut SG cloud-dev noise (prod keeps 500).
# EXPECTED: local PG <50ms healthy; India→Singapore Neon 500-1000ms per query NORMAL
# (70-90ms RTT + TLS + pgbouncer per query; 100+ sequential dashboard queries → ~70s wall).
# Prod (Singapore API → SG DB same-region) ~5ms. If slow on LOCAL PG: EXPLAIN (ANALYZE, BUFFERS) + N+1/groupBy.
# Dashboard uses single GROUP BY aggregations (no per-row fallback); TanStack staleTime ≥30s avoids refetch storms.
SLOW_QUERY_MS=1000
DB_METRICS_INTERVAL_MS=60000

# Local server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Required by src/config/index.ts + storage.ts (use dev placeholders, never prod keys)
AI_ENCRYPTION_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32_AI_LOCAL_64ch
CRON_SECRET=REPLACE_ME_generate_with_openssl_rand_hex_32_CRON_LOCAL_64ch
GROQ_API_KEY=
