# CampusFlow web — required prod env (placeholders only, never commit live values).
# Copy to .env for local dev: copy .env.example .env
# Vite bakes VITE_* at BUILD time into shipped JS (no runtime fix) — set in
# Vercel Dashboard (Production + Preview), then rebuild on change. Keep in sync with
# render.yaml campusflow-web envVars + backend FRONTEND_URL/CSP connect-src.

# VITE_API_URL (REQUIRED in prod builds): live Singapore API host.
VITE_API_URL=http://localhost:4000

# VITE_SITE_URL (SSOT canonical, REQUIRED in prod builds): canonical site host.
# Fallback `https://campusflow.dev` is a placeholder only — never leave unset in prod.
VITE_SITE_URL=http://localhost:3000

# ---- Optional (defaults work, uncomment to override) ----
# All Vercel dashboard only; leave unset/commented to disable locally.
#VITE_GSC_VERIFICATION= # Google Search Console token (Seo.tsx meta tag; missing = no tag)
#VITE_PLAUSIBLE_DOMAIN= # e.g. campusflow.dev (loads plausible.io script only when set + consented)
#VITE_GA4_ID= # e.g. G-XXXXXXXXXX (loads gtag.js only when set + consented)
#VITE_RUM_ENDPOINT= # RUM beacon URL (unset = console.debug local-only, no network)

# FORBIDDEN in Vercel (Production + Preview): VITE_GROQ_API_KEY must NEVER be set.
# WHY: Vite embeds VITE_* in the client bundle — setting this leaks the key
# (see apps/web/src/lib/api/groq.ts readEnvGroqKey; prod path is the backend proxy only).
# Kept commented here as a guard rail; do NOT uncomment in any committed file.
#VITE_GROQ_API_KEY=
